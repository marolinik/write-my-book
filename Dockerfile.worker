# P2-62: node pinned by exact version and digest (the 22-alpine tag on 2026-11-12).
FROM node:22.23-alpine3.24@sha256:5b05da3f938f1c604b24c633646d48805a6667f378cb4908438616f3cc48a0bf AS base

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# Wave 7 / D22: exports run on the worker, so its runtime carries the same
# converters and fonts as the web image (kept identical by a contract test).
FROM base AS export-tools
ENV TMPDIR=/tmp TEMP=/tmp TMP=/tmp
RUN apk add --no-cache pandoc curl \
    font-noto-cjk font-noto-naskh-arabic font-noto-arabic font-noto-devanagari
# Typst: static musl binary from GitHub releases, checked against its sha256.
ARG TYPST_VERSION=v0.13.0
ARG TYPST_SHA256=cd1148da61d6844e62c330fc6222e988480acafe33b76daec8eb5d221258feb6
RUN wget -qO /tmp/typst.tar.xz https://github.com/typst/typst/releases/download/${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz \
    && echo "${TYPST_SHA256}  /tmp/typst.tar.xz" | sha256sum -c - \
    && tar -xf /tmp/typst.tar.xz -C /tmp \
    && mv /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/ \
    && rm -rf /tmp/typst*

# P2-84: the runtime gets production dependencies only. devDependencies
# (vitest, playwright, jsdom, eslint, the prisma CLI) carry advisories the
# worker never loads, and ~100 MB.
FROM base AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
# Wave 7 Task 5: the worker never loads Next (scripts/check-worker-deps.mjs
# proves it on the compiled require graph), so its runtime drops Next, its
# native SWC binaries and the Sentry Next SDK that would load it.
RUN rm -rf node_modules/next node_modules/@next node_modules/@sentry/nextjs

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Generate Prisma client (needed for DB access in worker)
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"
RUN npx prisma generate

# Compile worker with TypeScript and resolve path aliases
RUN npx tsc --project tsconfig.worker.json && npx tsc-alias --project tsconfig.worker.json

FROM export-tools AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker

# Copy compiled worker output
COPY --from=builder /app/dist-worker ./dist-worker

# Production node_modules only (P2-84): bullmq, ioredis, @anthropic-ai/sdk,
# @prisma/client and the rest of "dependencies".
COPY --from=prod-deps /app/node_modules ./node_modules

# Copy Prisma schema and generated client
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts
COPY --from=builder /app/src/generated ./src/generated

# The export templates (Lua filters, reference DOCX, Typst template).
COPY --from=builder /app/export-templates ./export-templates

# Copy package.json for module resolution
COPY --from=builder /app/package.json ./package.json

# Fail the build, not the boot, if the worker requires a package the pruned
# install does not have.
COPY scripts/check-worker-deps.mjs ./scripts/check-worker-deps.mjs
RUN node scripts/check-worker-deps.mjs dist-worker

USER worker
CMD ["node", "dist-worker/worker.js"]
