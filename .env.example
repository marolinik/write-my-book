# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/writemybook?schema=public"

# Redis
REDIS_URL="redis://:wmb-redis-prod@localhost:6379"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="wmb-minio"
S3_SECRET_ACCESS_KEY="wmb-minio-prod"
S3_BUCKET="wmb-projects"
S3_FORCE_PATH_STYLE="true"
S3_REGION="us-east-1"

# Clerk (https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"

# Encryption (generate: openssl rand -hex 32)
API_KEY_ENCRYPTION_SECRET="changeme-generate-with-openssl-rand-hex-32-xxxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Billing (REQUIRED by scripts/check-env web target — see docs/env-vars.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Plan price IDs — 7 required (Free plan is the absence of a subscription)
STRIPE_FOUNDER_MONTHLY_PRICE_ID=
STRIPE_INDIE_MONTHLY_PRICE_ID=
STRIPE_INDIE_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_PUBLISHER_MONTHLY_PRICE_ID=
STRIPE_PUBLISHER_ANNUAL_PRICE_ID=

# E2E Testing
E2E_TEST_SECRET=test-secret

# Health endpoint auth (optional, PRODUCTION RECOMMENDED)
# When set, /api/health/dependencies returns per-dependency detail only to
# callers sending `x-health-token: <value>`. Anonymous callers always get the
# verdict (200/503 + names/status) but never host/port detail. Container
# healthchecks (loopback) keep working either way.
HEALTH_TOKEN=

# Private-IP LLM endpoints (self-hosted LAN vLLM boxes)
# The saved-model-provider "Add endpoint" flow validates the base URL against
# cloud-metadata/link-local ranges ALWAYS, and against private LAN ranges too
# UNLESS this is "1". Set only on a single-tenant self-host where writers are
# trusted with your LAN; leave unset (default, strict) on hosted deployments.
WMB_ALLOW_PRIVATE_MODEL_HOSTS=

# Dev Auth Bypass -- set to "true" to skip Clerk in local dev
DEV_AUTH_BYPASS=true
DEV_AUTH_USER_NAME=dev-user
DEV_CLERK_ID=user_dev_bypass

# Neo4j (Knowledge Graph)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="wmb-neo4j-dev"

# Qdrant (Vector DB)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="wmb-qdrant-prod"

# OpenAI (for embeddings -- optional, vector features disabled without this)
OPENAI_API_KEY=sk-REPLACE_ME

# OpenRouter (optional -- alternative LLM provider)
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# Anthropic (primary LLM provider)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Serper (optional -- enables Google-quality web search for agents; used as a
# fallback when Perplexity is not configured or is unavailable)
SERPER_API_KEY=REPLACE_ME

# Perplexity (optional -- when set, WebSearch uses Perplexity's answer engine
# with citations first, then falls back to Serper, then DuckDuckGo)
PERPLEXITY_API_KEY=REPLACE_ME
# PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions
# PERPLEXITY_MODEL=sonar

# Firecrawl (optional -- when set, FetchWebPage uses Firecrawl to return clean
# markdown instead of a raw HTML scrape; falls back to an in-process fetch+strip)
FIRECRAWL_API_KEY=REPLACE_ME
# FIRECRAWL_API_URL=https://api.firecrawl.dev/v1/scrape

# Sentry (optional -- error tracking disabled without DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Managed no-key tier (D4) ---
# OFF unless BOTH are set. A cold Free writer with no provider key of their
# own then runs on the product's key, under a per-writer daily and monthly
# cap (src/lib/billing/managed-tier.ts). Every run it pays for is recorded
# with key_source = platform, which the spend panel already separates.
# This spends YOUR money. Leave both empty to keep the historical behaviour:
# no key means an explicit, honest refusal.

# Platform default model. Unset falls back to openrouter-deepseek-flash/sonnet
# (DeepSeek V4.1 Flash, 0.15/0.60 per million, 1M context). The self-hosted
# fleet is still in the registry as local-deepseek/* — set this to that id to
# make the fleet the default instead, or leave it and let WMB_LOCAL_FALLBACK
# catch writers who have no key.
WMB_DEFAULT_MODEL=

MANAGED_TIER_ENABLED=
WMB_MANAGED_KEY=
WMB_MANAGED_KEY_PROVIDER=

# --- Beta gate judged instead of parsed ---
# OFF unless BOTH are set. The 402-line regex in beta-reader-parser.ts stays
# as the fallback and still recovers personas, emotions and engagement.
# Measured over 28 real Serbian reports: the parser produced a score on 3 of
# 28 and matched the report's own verdict 7 of 21; the judge scored 28 of 28
# and matched 15 of 21, 14 of 17 above its confidence floor.
TYPESAFE_API_KEY=
BETA_JUDGE_ENABLED=

# --- Findings triaged, and stock prose marked, after every editorial pass ---
# Both run at the end of a line-edit (triage also after dev-edit) and need
# TYPESAFE_API_KEY above. Each is OFF unless its own flag is 1.
# Triage: Lektura opens on the five notes that would do most for a reader.
# Stock prose: a paragraph of images any story could use, named feelings or
# quotable closers gets a "look again" suggestion. It never says who wrote it:
# asking that failed on held-out chapters (2 of 12 model paragraphs caught).
FINDING_TRIAGE_ENABLED=
STOCK_PROSE_ENABLED=
