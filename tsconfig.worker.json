{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist-worker",
    "noEmit": false,
    "esModuleInterop": true,
    "declaration": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/worker.ts", "src/lib/**/*.ts", "src/generated/**/*.ts"],
  "exclude": ["node_modules", "src/app/**", "src/components/**", "src/hooks/**", "src/stores/**"]
}
