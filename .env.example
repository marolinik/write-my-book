# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/writemybook?schema=public"

# Redis
REDIS_URL="redis://:wmb-redis-prod@localhost:6379"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="wmb-minio"
S3_SECRET_ACCESS_KEY="wmb-minio-prod"
S3_BUCKET="wmb-projects"
S3_FORCE_PATH_STYLE="true"
S3_REGION="us-east-1"

# Clerk (https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"

# Encryption (generate: openssl rand -hex 32)
API_KEY_ENCRYPTION_SECRET="change-me-in-production-use-a-long-random-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Billing (optional -- billing features disabled without these)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# E2E Testing
E2E_TEST_SECRET=test-secret

# Dev Auth Bypass -- set to "true" to skip Clerk in local dev
DEV_AUTH_BYPASS=true
DEV_AUTH_USER_NAME=dev-user
DEV_CLERK_ID=user_dev_bypass

# Neo4j (Knowledge Graph)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="wmb-neo4j-dev"

# Qdrant (Vector DB)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="wmb-qdrant-prod"

# OpenAI (for embeddings -- optional, vector features disabled without this)
OPENAI_API_KEY=sk-REPLACE_ME

# OpenRouter (optional -- alternative LLM provider)
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# Anthropic (primary LLM provider)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Serper (optional -- enables Google-quality web search for agents)
SERPER_API_KEY=REPLACE_ME

# Sentry (optional -- error tracking disabled without DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
