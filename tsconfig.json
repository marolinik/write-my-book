{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // One-shot QA campaign evidence harnesses / scripts (not product code).
    // Self-contained Playwright probe scripts, excluded from the app typecheck
    // program on purpose.
    "cowork/**",
    // Audit scratch scripts (gitignored, one-shot DB probes). They are not
    // product code and must not be able to fail `next build`: the 0921 S5
    // session's first production build in the project's history failed on a
    // throwaway query script, not on the app.
    "tmp-audit/**"
  ]
}
