# P2-62: node pinned by exact version and digest (the 22-alpine tag on 2026-11-12).
FROM node:22.23-alpine3.24@sha256:5b05da3f938f1c604b24c633646d48805a6667f378cb4908438616f3cc48a0bf AS base

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# P2-84: the runtime gets production dependencies only. devDependencies
# (vitest, playwright, jsdom, eslint, the prisma CLI) carry advisories the
# worker never loads, and ~100 MB.
FROM base AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Generate Prisma client (needed for DB access in worker)
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"
RUN npx prisma generate

# Compile worker with TypeScript and resolve path aliases
RUN npx tsc --project tsconfig.worker.json && npx tsc-alias --project tsconfig.worker.json

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker

# Copy compiled worker output
COPY --from=builder /app/dist-worker ./dist-worker

# Production node_modules only (P2-84): bullmq, ioredis, @anthropic-ai/sdk,
# @prisma/client and the rest of "dependencies".
COPY --from=prod-deps /app/node_modules ./node_modules

# Copy Prisma schema and generated client
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts
COPY --from=builder /app/src/generated ./src/generated

# Copy package.json for module resolution
COPY --from=builder /app/package.json ./package.json

# Fail the build, not the boot, if the worker requires a package the pruned
# install does not have.
COPY scripts/check-worker-deps.cjs ./scripts/check-worker-deps.cjs
RUN node scripts/check-worker-deps.cjs dist-worker

USER worker
CMD ["node", "dist-worker/worker.js"]
