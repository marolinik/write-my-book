{
  "name": "platform-new",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:lowmem": "vitest run --pool=forks --poolOptions.forks.maxForks=2",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "worker:dev": "npx tsx src/worker.ts",
    "worker:build": "tsc --project tsconfig.worker.json && tsc-alias --project tsconfig.worker.json",
    "worker:start": "node dist-worker/worker.js",
    "env:check": "tsx scripts/check-env.ts web",
    "legal:check": "tsx scripts/check-legal-placeholders.ts",
    "graph:init": "tsx scripts/graph-init.ts",
    "schema:contract": "tsx scripts/generate-schema-contract.ts",
    "env:check:worker": "tsx scripts/check-env.ts worker",
    "smoke:deployment": "tsx scripts/smoke-deployment.ts",
    "billing:check": "tsx scripts/check-stripe-config.ts",
    "auth:check": "tsx scripts/check-clerk-config.ts",
    "db:deploy:check": "tsx scripts/check-db-deploy.ts",
    "db:diff": "tsx scripts/check-db-deploy.ts --diff && npx prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script -o prisma/pending-change.sql",
    "db:apply": "npm run db:deploy:check && npx tsx scripts/repair-duplicate-documents.ts --execute && npx prisma db execute --file scripts/pre-apply.sql && npx prisma db execute --file prisma/pending-change.sql && npm run db:guards",
    "db:push:prod": "echo \"Schema changes are reviewed SQL now: npm run db:diff, read prisma/pending-change.sql, then npm run db:apply\" && exit 1",
    "db:guards": "tsx scripts/apply-db-guards.ts",
    "test:deployment-smoke": "playwright test --config playwright.deployment.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@clerk/nextjs": "^6.39.8",
    "@clerk/themes": "^2.4.57",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@qdrant/js-client-rest": "^1.20.0",
    "@sentry/nextjs": "^10.78.0",
    "@sentry/node": "^10.78.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-focus": "3.33.0",
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-text-align": "3.33.0",
    "@tiptap/extension-underline": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@types/d3-force": "^3.0.10",
    "@types/turndown": "^5.0.6",
    "@typesafe-ai/sdk": "^0.7.0",
    "bullmq": "^5.70.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.1",
    "dotenv": "^17.2.4",
    "idb": "8.0.4",
    "ioredis": "^5.9.2",
    "jsonrepair": "3.15.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.13.0",
    "neo4j-driver": "^6.3.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "openai": "^6.21.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.21.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^20.3.1",
    "svix": "^1.86.0",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "turndown": "^7.2.5",
    "zod": "^4.3.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.6",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "prisma": "^7.10.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": "22.x"
  }
}
