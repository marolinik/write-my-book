<?xml version="1.0" encoding="UTF-8"?>
$-- WMB DOCX document template (word/document.xml).
$-- Used with: pandoc --to=docx --template=docx-book.openxml
$--
$-- pandoc 3.9's default.openxml WITHOUT its title block (title, subtitle,
$-- author, date, abstract). The pipeline keeps title/author in the metadata
$-- for the file's dc:title/dc:creator, and the default template printed them
$-- as a visible Title/Author block ahead of the half-title the export config
$-- asked for (P3-S19). The front matter supplies its own title pages.
<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing">
<w:body>
$for(include-before)$
    $include-before$
$endfor$
$if(toc)$
    $toc$
$endif$
$if(lof)$
    $lof$
$endif$
$if(lot)$
    $lot$
$endif$
    $body$
$for(include-after)$
    $include-after$
$endfor$
    $sectpr$
  </w:body>
</w:document>
