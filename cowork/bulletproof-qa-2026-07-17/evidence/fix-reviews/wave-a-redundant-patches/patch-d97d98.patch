+/**
+ * Render a USD amount for the morning report. A naive `toFixed(2)` flattens any
+ * sub-cent figure (e.g. a `$0.004` cap) to a misleading "$0.00" — which reads as
+ * "no budget" — so precision is widened until the amount renders non-zero. A
+ * real, positive cap/spend is never printed as "$0.00" (NEW-2). A true zero (or
+ * a non-finite guard value) still renders "$0.00".
+ */
+function formatUsd(value: number): string {
+  if (!Number.isFinite(value) || value <= 0) return "$0.00";
+  const twoDp = value.toFixed(2);
+  if (Number(twoDp) !== 0) return `$${twoDp}`;
+  for (let precision = 3; precision <= 6; precision++) {
+    const widened = value.toFixed(precision);
+    if (Number(widened) !== 0) return `$${widened}`;
+  }
+  return `$${value.toFixed(6)}`;
+}
+
+/** Human-readable halt reason for the morning-notification copy (D-98). */
+function humanizeHaltReason(reason: BatchHaltReason): string {
+  switch (reason) {
+    case "budget_cap":
+      return "budget cap reached";
+    case "provider_failures":
+      return "provider failures";
+    case "cancelled":
+      return "cancelled";
+    default:
+      return "halted";
+  }
+}
+
+/**
+ * Terminal-state title for the morning notification. A halted / failed /
+ * cancelled batch must NOT be reported as "complete" (D-98): the title states
+ * what actually happened, and a halt names its reason.
+ */
+function batchNotificationTitle(
+  status: DerivedBatchStatus,
+  haltReason: BatchHaltReason
+): string {
+  switch (status) {
+    case "halted":
+      return `Overnight batch halted — ${humanizeHaltReason(haltReason)}`;
+    case "cancelled":
+      return "Overnight batch cancelled";
+    case "failed":
+      return "Overnight batch failed";
+    default:
+      return "Overnight batch complete";
+  }
+}
