# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# subagent-driven-development scratch (ledger + review diff packages)
/.superpowers

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.docker

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# worker build output
/dist-worker

# Office temp lock files
~$*
playwright-report-deployment/
playwright-report/
test-results/

# local scratch files (tmp-* investigation/export artifacts — never commit)
tmp-*

# UAT screenshots (regenerated locally, not source)
uat-screenshots/
ork.txt
